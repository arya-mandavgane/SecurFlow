# ==============================================================================
# SecurFlow Environment Variables Template
# ==============================================================================

# General
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=securflow-insecure-dev-secret-key-change-in-production-2026!

# Core Backend Database (PostgreSQL + pgvector)
DB_NAME=securflow_db
DB_USER=securflow_user
DB_PASSWORD=securflow_secure_pass_2026
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgres://securflow_user:securflow_secure_pass_2026@postgres:5432/securflow_db
USE_SQLITE=False

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Microservice URLs (Internal Docker Network)
AI_SERVICE_URL=http://ai-service:8001
OCR_SERVICE_URL=http://ocr-service:8002
BACKEND_API_URL=http://backend:8000/api

# Client Origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Service Configuration
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIMENSION=1536

# OCR Service Configuration
PADDLE_OCR_LANG=en
OCR_CONFIDENCE_THRESHOLD=0.75

# Email Settings (Console backend in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.aicte-india.org
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@aicte-india.org
EMAIL_HOST_PASSWORD=samplepassword
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SecurFlow AICTE <no-reply@aicte-india.org>
